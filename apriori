from itertools import combinations

transactions = [
    ['bread','milk'],
    ['bread','diaper','beer','egg'],
    ['milk','diaper','beer','coke'],
    ['bread','milk','diaper','beer'],
    ['bread','milk','diaper','coke']
]

def apriori(transactions, min_support):
    items = set(item for trans in transactions for item in trans)
    freq_items = {}

    for i in range(1,3):
        for combo in combinations(items,i):
            count = sum(1 for trans in transactions if set(combo).issubset(trans))
            support = count/len(transactions)

            if support >= min_support:
                freq_items[combo] = support

    return freq_items

# Example 1
result = apriori(transactions,0.4)
print("Example 1 Frequent Itemsets:")
print(result)

# Example 2
result2 = apriori(transactions,0.6)
print("\nExample 2 Frequent Itemsets:")
print(result2)
